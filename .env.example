# Database
POSTGRES_USER=medcore
POSTGRES_PASSWORD=medcore_dev_password
POSTGRES_DB=medcore
POSTGRES_PORT=5433
DATABASE_URL=postgresql://medcore:medcore_dev_password@localhost:5433/medcore?schema=public
SHADOW_DATABASE_URL=postgresql://medcore:medcore_dev_password@localhost:5433/medcore_shadow?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
JWT_ACCESS_SECRET=replace-with-256-bit-random-string-access
JWT_REFRESH_SECRET=replace-with-256-bit-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_COST=12
FRONTEND_URL=http://localhost:3000

# Optional providers (dev falls back to console logging)
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
